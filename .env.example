# Copia este archivo a `.env` y rellena los valores reales.
# NO versiones tu `.env`. Aquí no debe haber ningún secreto real.

# Cadena de conexión de PostgreSQL para Prisma.
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASEDATOS?schema=public
DATABASE_URL=

# Token del bot de Telegram (lo da @BotFather).
TELEGRAM_BOT_TOKEN=

# API key de Anthropic (Claude).
ANTHROPIC_API_KEY=

# Opcional: modelo de Claude a usar. Por defecto: claude-opus-4-8
ANTHROPIC_MODEL=
