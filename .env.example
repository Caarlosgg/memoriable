# Copia este archivo a `.env` y rellena los valores reales.
# NO versiones tu `.env`. Aquí no debe haber ningún secreto real.

# Cadena de conexión de PostgreSQL para Prisma (runtime del bot).
# En Supabase, usa el pooler de Supavisor en modo TRANSACCIÓN (puerto 6543):
#   postgresql://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Conexión directa para migraciones (prisma migrate). Prisma no puede migrar a
# través del modo transacción; usa el pooler en modo SESIÓN (puerto 5432):
#   postgresql://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# Token del bot de Telegram (lo da @BotFather).
TELEGRAM_BOT_TOKEN=

# API key de Groq (console.groq.com, tiene plan gratuito).
GROQ_API_KEY=

# Opcional: modelo servido por Groq a usar. Por defecto: openai/gpt-oss-120b
# (modelo abierto de OpenAI servido por Groq: barato y muy rápido, sobrado
# para clasificar/resumir un mensaje corto).
GROQ_MODEL=

# Opcional: API key de Gemini (aistudio.google.com/apikey, gratis: 1500
# peticiones/día, sin tarjeta), para generar el embedding de cada mensaje
# (búsqueda semántica, Fase 2). Sin ella, los mensajes se guardan igual,
# solo que sin embedding — no bloquea nada.
GEMINI_API_KEY=

# Opcional: modelo de embeddings a usar. Por defecto: gemini-embedding-001.
GEMINI_MODEL=

# Opcional: fusible de coste. Máximo de llamadas a la API de Groq por día;
# al superarlo, se cae al categorizador offline. Por defecto: 50.
MAX_MESSAGES_PER_DAY=

# Opcional: fichero donde persiste el contador del fusible de coste (debe ser
# escribible). Por defecto: .budget.json. En Docker se fija a /data/budget.json.
BUDGET_FILE=

# Chat de Telegram al que enviar el resumen diario proactivo. Si se deja vacío,
# el resumen diario no se programa (el resto del bot sigue funcionando).
# Consíguelo escribiendo al bot y mirando los logs, o con @userinfobot.
TELEGRAM_CHAT_ID=

# Opcional: hora local (0-23) a la que se envía el resumen diario. Por defecto: 9.
DAILY_SUMMARY_HOUR=

# Opcional: fichero donde persiste la marca del último resumen diario enviado
# (para no duplicar tras un reinicio). Por defecto: .daily-summary.json.
DAILY_SUMMARY_STATE_FILE=

# Opcional: zona horaria (IANA) en la que el bot enseña las fechas de las
# tarjetas. Por defecto: Europe/Madrid. Antes eran UTC fijo, lo que pintaba
# cada nota una o dos horas antes de cuando se escribió.
BOT_TIMEZONE=

# Opcional: URL base del dashboard, para que las tarjetas de Telegram puedan
# enlazar la nota ("Abrir en el dashboard"). Sin ella, las tarjetas salen
# igual pero sin enlace. Ejemplo: https://memoriable.vercel.app
DASHBOARD_URL=

# Opcional: nivel de log (debug|info|warn|error). Por defecto: info.
LOG_LEVEL=
