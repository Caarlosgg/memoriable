// Copia propia del schema del bot (../../prisma/schema.prisma), MISMO
// modelo y datasource. No es un "segundo generador" del schema
// compartido: es una copia física, a propósito.
//
// Motivo: Prisma resuelve `@prisma/client`/`prisma` recorriendo los
// directorios ANCESTROS del propio schema.prisma, nunca directorios
// hermanos. Si este generator viviera en el schema de la raíz (como antes),
// necesitaría encontrar node_modules en la raíz del repo — y en Vercel, con
// Root Directory=dashboard, el `npm install` de la raíz nunca se ejecuta.
// Sin esa copia, Prisma intentaba auto-instalarse a mitad del build
// (`npm i prisma@... -D --silent`) y esa instalación anidada fallaba.
//
// Con el schema aquí dentro, la resolución sube desde dashboard/prisma/
// hasta dashboard/node_modules — que sí existe siempre, tanto en local como
// en Vercel — sin necesitar auto-instalar nada ni depender de la raíz.
//
// Si cambias el modelo `Message` o el datasource, replica el cambio en
// ../../prisma/schema.prisma (el schema real del bot, que sigue siendo la
// fuente de verdad para las migraciones).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  // Runtime del dashboard: pooler de Supavisor en modo transacción (puerto
  // 6543). El dashboard nunca migra, así que no necesita DIRECT_URL.
  url        = env("DATABASE_URL")
  // pgvector: la activa/migra el bot (ver ../../prisma/), el dashboard solo
  // la declara para que `prisma generate` sepa tratar `embedding` como
  // Unsupported en vez de como drift.
  extensions = [vector]
}

/// Ver ../../prisma/schema.prisma: cuenta del dashboard (multiusuario, Fase 2).
model User {
  id    String @id @default(cuid())
  email String @unique
  /// Opcional desde el login con Google: una cuenta creada solo por OAuth no
  /// tiene contraseña propia (ver login/actions.ts, caso passwordHash null).
  passwordHash String?
  createdAt    DateTime @default(now())

  /// Si el registro fue por email/contraseña, empieza en false hasta que
  /// confirme el enlace del correo de verificación. Las cuentas por Google
  /// nacen ya verificadas (el id_token de Google ya certifica el email).
  emailVerified Boolean @default(false)

  /// Ver ../../prisma/schema.prisma: cuenta corporativa pendiente de activar.
  accountPending Boolean @default(false)

  telegramChatId    BigInt?   @unique
  linkCode          String?   @unique
  linkCodeExpiresAt DateTime?

  /// Ver ../../prisma/schema.prisma: workspace personal autocreado (Fase Equipo).
  personalWorkspaceId String?    @unique
  personalWorkspace   Workspace? @relation("PersonalWorkspace", fields: [personalWorkspaceId], references: [id])

  messages         Message[]           @relation("MessageAuthor")
  assignedMessages Message[]           @relation("MessageAssignee")
  exchanges        AssistantExchange[]
  conversations    Conversation[]
  eventos          Evento[]            @relation("EventoAuthor")
  assignedEventos  Evento[]            @relation("EventoAssignee")
  cuentasAhorro    CuentaAhorro[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  memberships      Membership[]
  notifications    Notification[]

  @@map("users")
}

/// Ver ../../prisma/schema.prisma: espacio de trabajo, personal o de
/// equipo (Fase Equipo). Message/Evento cuelgan de un Workspace, no
/// directamente de un User.
model Workspace {
  id        String   @id @default(cuid())
  nombre    String
  personal  Boolean  @default(false)
  createdAt DateTime @default(now())

  memberships    Membership[]
  messages       Message[]
  eventos        Evento[]
  campoTemplates CampoTemplate[]
  personalOf     User?    @relation("PersonalWorkspace")

  @@map("workspaces")
}

/// Ver ../../prisma/schema.prisma: plantilla de campos personalizados por categoría (Fase Equipo).
model CampoTemplate {
  id        String   @id @default(cuid())
  categoria String
  campos    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, categoria])
  @@index([workspaceId])
  @@map("campo_templates")
}

/// Ver ../../prisma/schema.prisma: rol dentro de un workspace de equipo (Fase Equipo).
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

/// Ver ../../prisma/schema.prisma: estado de una membresía (Fase Equipo).
enum MembershipStatus {
  PENDING
  ACTIVE
}

/// Ver ../../prisma/schema.prisma: pertenencia usuario↔workspace (Fase Equipo).
model Membership {
  userId      String
  workspaceId String
  role        WorkspaceRole    @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

/// Ver ../../prisma/schema.prisma: token de un solo uso para confirmar el
/// email al registrarse (registro/login profesional del dashboard).
model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

/// Ver ../../prisma/schema.prisma: token de un solo uso para restablecer la
/// contraseña. Modelo aparte de VerificationToken a propósito.
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Ver ../../prisma/schema.prisma: tipo de notificación (Fase Equipo).
enum NotificationType {
  ASSIGNED_MESSAGE
  ASSIGNED_EVENTO
  ADDED_TO_TEAM
  ROLE_CHANGED
}

/// Ver ../../prisma/schema.prisma: notificación en la app.
model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

/// Ver ../../prisma/schema.prisma: estado en el tablero kanban (Fase 3).
enum EstadoTarea {
  POR_HACER
  EN_PROGRESO
  HECHO
}

/// Ver ../../prisma/schema.prisma: prioridad en el tablero kanban (Fase 3).
enum Prioridad {
  BAJA
  MEDIA
  ALTA
}

/// Un mensaje entrante ya categorizado y resumido.
model Message {
  id        String   @id @default(cuid())
  /// Tipo de mensaje (p.ej. "text").
  tipo      String
  /// Contenido original del mensaje.
  contenido String
  /// Categoría asignada por la IA (tarea, idea, pregunta, ...).
  categoria String
  /// Resumen conciso generado por la IA.
  resumen   String
  /// ¿Está marcado como hecho? Se mantiene sincronizado con `estado`.
  hecho     Boolean     @default(false)
  /// Estado en el tablero kanban (Fase 3). Nace en POR_HACER.
  estado    EstadoTarea @default(POR_HACER)
  /// Prioridad en el tablero kanban (Fase 3). Nace en MEDIA.
  prioridad Prioridad   @default(MEDIA)
  /// Fecha de recepción/procesamiento.
  fecha     DateTime @default(now())

  /// Ver ../../prisma/schema.prisma: etiquetas libres (Fase F/J).
  etiquetas String[] @default([])

  /// Ver ../../prisma/schema.prisma: campos extra personalizados (Fase E).
  camposExtra Json @default("{}")

  /// Ver ../../prisma/schema.prisma: checklist/subtareas — array [{id, texto, hecho}].
  checklist Json @default("[]")

  /// Ver ../../prisma/schema.prisma: imágenes adjuntas (Fase D), URLs de
  /// Vercel Blob. Array simple en vez de una tabla Attachment aparte:
  /// proporcional al uso real (una nota, unas pocas capturas, no un
  /// gestor de ficheros).
  imagenes String[] @default([])

  /// Posición dentro de su columna del tablero kanban: al crearse, la hora
  /// actual en milisegundos (siempre creciente, sin necesitar consultar el
  /// máximo actual). Al arrastrar una tarjeta a una posición nueva, se
  /// recalcula como el punto medio entre sus dos vecinas — indexado
  /// fraccionario, evita tener que renumerar el resto de la columna en
  /// cada arrastre.
  orden Float @default(0)

  /// Ver ../../prisma/schema.prisma: obligatorio, backfill ya completado.
  /// Quien la creó — nunca cambia, aunque se asigne a otra persona.
  userId String
  user   User   @relation("MessageAuthor", fields: [userId], references: [id])

  /// Ver ../../prisma/schema.prisma: workspace en el que vive (Fase Equipo).
  /// NOT NULL desde 20260810130000_require_message_workspace.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  /// Ver ../../prisma/schema.prisma: a quién se ha asignado (Fase Equipo).
  assigneeId String?
  assignee   User?   @relation("MessageAssignee", fields: [assigneeId], references: [id])

  /// Ver ../../prisma/schema.prisma para el porqué de las dimensiones y del
  /// acceso vía $queryRaw/$executeRaw (Prisma no soporta Unsupported en el
  /// cliente tipado).
  embedding Unsupported("vector(768)")?

  /// Ver ../../prisma/schema.prisma: eventos del calendario (Fase I).
  eventos Evento[]

  @@index([categoria])
  @@index([fecha])
  @@index([hecho])
  @@index([userId])
  @@index([estado])
  @@index([orden])
  @@index([workspaceId])
  @@index([assigneeId])
  @@map("messages")
}

/// Ver ../../prisma/schema.prisma: evento del calendario (Fase I).
model Evento {
  id            String    @id @default(cuid())
  titulo        String
  descripcion   String?
  fechaInicio   DateTime
  fechaFin      DateTime?
  ubicacion     String?
  participantes String[]  @default([])
  createdAt     DateTime  @default(now())

  /// Quien lo creó — nunca cambia, aunque se asigne a otra persona.
  userId String
  user   User   @relation("EventoAuthor", fields: [userId], references: [id])

  /// Ver Message.workspaceId — mismo criterio.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  /// Ver Message.assigneeId — mismo criterio.
  assigneeId String?
  assignee   User?   @relation("EventoAssignee", fields: [assigneeId], references: [id])

  messageId String?
  message   Message? @relation(fields: [messageId], references: [id])

  @@index([userId])
  @@index([fechaInicio])
  @@index([workspaceId])
  @@index([assigneeId])
  @@map("eventos")
}

/// Ver ../../prisma/schema.prisma: cuenta/bucket de ahorro (Fase K).
model CuentaAhorro {
  id               String   @id @default(cuid())
  nombre           String
  objetivoCentimos Int?
  createdAt        DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  movimientos MovimientoAhorro[]

  @@index([userId])
  @@map("cuentas_ahorro")
}

/// Ver ../../prisma/schema.prisma: movimiento de una cuenta de ahorro (Fase K).
model MovimientoAhorro {
  id       String   @id @default(cuid())
  centimos Int
  concepto String?
  fecha    DateTime @default(now())

  cuentaId String
  cuenta   CuentaAhorro @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@index([cuentaId])
  @@map("movimientos_ahorro")
}

/// Ver ../../prisma/schema.prisma: fusible de coste propio del Asistente,
/// backed por Postgres porque el dashboard es serverless (sin disco
/// persistente entre invocaciones).
model AssistantBudget {
  day   String @id
  count Int    @default(0)

  @@map("assistant_budget")
}

/// Ver ../../prisma/schema.prisma: rate limiting distribuido (login/registro).
model RateLimitBucket {
  bucketKey   String
  windowStart DateTime
  count       Int      @default(0)

  @@id([bucketKey, windowStart])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}

/// Ver ../../prisma/schema.prisma: conversación del Asistente (Fase 5).
model Conversation {
  id        String   @id @default(cuid())
  titulo    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  exchanges AssistantExchange[]

  @@index([userId])
  @@map("conversations")
}

/// Ver ../../prisma/schema.prisma: historial de intercambios con el
/// Asistente, purgado solo por un Cron Job semanal de Vercel.
model AssistantExchange {
  id        String   @id @default(cuid())
  pregunta  String
  respuesta String
  fecha     DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  @@index([fecha])
  @@index([userId])
  @@index([conversationId])
  @@map("assistant_exchanges")
}
