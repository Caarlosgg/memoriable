# Copia este archivo a .env.local y rellena los valores reales.
# NO versiones .env.local. Aquí no debe haber ningún secreto real.

# Misma cadena de conexión PostgreSQL que usa el bot (pooler de Supavisor,
# modo transacción, puerto 6543). Cópiala tal cual desde el .env del bot.
DATABASE_URL=

# Clave para firmar la cookie de sesión (JWT). Cualquier cadena larga y
# aleatoria sirve (p. ej. `openssl rand -base64 32`) — no es la contraseña
# de nadie, solo protege la firma. Si cambia, todas las sesiones ya
# emitidas dejan de ser válidas.
SESSION_SECRET=

# Opcional: nombre de usuario del bot de Telegram (sin @), p. ej. "MiBot".
# Con esto, "Cuenta" en el dashboard muestra un botón que abre Telegram con
# el código de vínculo ya rellenado (t.me/<bot>?start=<código>) en vez de
# pedir que se escriba "/vincular <código>" a mano. Público a propósito
# (NEXT_PUBLIC_*): el usuario de un bot ya es público por naturaleza.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Opcional: API key de Groq, para que la captura rápida del dashboard
# categorice/resuma con la misma IA que el bot (console.groq.com). Sin
# ella, la captura sigue funcionando con el categorizador heurístico
# offline, igual que hace el bot cuando falta esta variable.
GROQ_API_KEY=

# Opcional: modelo servido por Groq a usar. Por defecto: openai/gpt-oss-120b.
GROQ_MODEL=

# Opcional: API key de Gemini (aistudio.google.com/apikey, gratis: 1500
# peticiones/día, sin tarjeta). Genera el embedding de cada mensaje guardado
# (búsqueda semántica, Buscador y Asistente) y el de cada pregunta al
# Asistente. Sin ella: los mensajes se guardan igual (sin embedding) y el
# Buscador/Asistente funcionan solo con texto — no bloquea nada.
GEMINI_API_KEY=

# Opcional: modelo de embeddings a usar. Por defecto: gemini-embedding-001.
GEMINI_MODEL=

# Opcional: fusible de coste propio del Asistente conversacional (independiente
# de MAX_MESSAGES_PER_DAY, que es del bot). Máximo de preguntas por día;
# al superarlo, el Asistente responde con un aviso claro en vez de gastar
# más llamadas a Gemini/Groq. Por defecto: 30.
ASSISTANT_MAX_QUESTIONS_PER_DAY=

# Opcional pero recomendada en producción: valor aleatorio propio que
# protege /api/cron/purge-assistant-history (purga semanal del historial
# del Asistente) de llamadas externas. Vercel envía este valor solo en
# sus propias llamadas al Cron Job (ver vercel.json) — sin ella, la ruta
# sigue funcionando pero cualquiera con la URL podría dispararla.
CRON_SECRET=

# Opcional: observabilidad de errores en producción (Sentry). Hoy los
# errores solo quedan en `console.error`, invisibles fuera de los logs de
# Vercel. Sin esta variable, Sentry no se activa — el resto de la app
# sigue funcionando exactamente igual (ver instrumentation.ts). Crea una
# cuenta gratis en sentry.io, un proyecto Next.js, y copia el DSN de ahí.
SENTRY_DSN=

# Igual que SENTRY_DSN pero para el navegador (necesita el prefijo
# NEXT_PUBLIC_ para quedar expuesta al bundle del cliente). Normalmente es
# el mismo valor que SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN=

# Opcional: API key de Resend (resend.com, gratis hasta 100 emails/día),
# para mandar el correo de verificación al registrarse. Sin ella, la cuenta
# se crea igual pero el correo no se envía — desde /login siempre se puede
# pedir que se reenvíe una vez esté configurada.
RESEND_API_KEY=

# Opcionales: login con Google (OAuth2/OIDC). Sin ellas, el botón "Entrar
# con Google" no aparece — el resto del login/registro sigue funcionando
# igual. Credenciales desde Google Cloud Console (pantalla de consentimiento
# + client ID/secret), redirect URI: https://<dominio>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcionales: solo hacen falta si además quieres que el build suba los
# source maps a Sentry (para ver el código real, no el minificado, al
# investigar un error). Slug de la organización/proyecto en sentry.io —
# sin ellos, next.config.ts no envuelve la build con Sentry y todo sigue
# funcionando igual, solo sin subir source maps.
SENTRY_ORG=
SENTRY_PROJECT=
