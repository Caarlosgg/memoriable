# Copia este archivo a .env.local y rellena los valores reales.
# NO versiones .env.local. Aquí no debe haber ningún secreto real.

# Misma cadena de conexión PostgreSQL que usa el bot (pooler de Supavisor,
# modo transacción, puerto 6543). Cópiala tal cual desde el .env del bot.
DATABASE_URL=

# Contraseña de acceso al dashboard. Cualquiera que la conozca puede entrar:
# elige algo largo y único, no la reutilices de otro sitio.
DASHBOARD_PASSWORD=

# Opcional: API key de Groq, para que la captura rápida del dashboard
# categorice/resuma con la misma IA que el bot (console.groq.com). Sin
# ella, la captura sigue funcionando con el categorizador heurístico
# offline, igual que hace el bot cuando falta esta variable.
GROQ_API_KEY=

# Opcional: modelo servido por Groq a usar. Por defecto: openai/gpt-oss-120b.
GROQ_MODEL=
