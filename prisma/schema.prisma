// Esquema de Prisma para el clasificador de mensajes.
//
// La cadena de conexión llega por DATABASE_URL (en .env), NUNCA hardcodeada.
// Genera el cliente con `npm run prisma:generate` y crea la tabla con
// `npm run prisma:migrate` una vez tengas una base de datos PostgreSQL.

generator client {
  provider        = "prisma-client-js"
  // Necesario para declarar `extensions = [vector]` abajo. No cambia cómo se
  // generan los modelos normales.
  previewFeatures = ["postgresqlExtensions"]
}

// El dashboard (Next.js, app aparte en dashboard/, con su propio
// node_modules) mantiene su PROPIA copia de este schema en
// dashboard/prisma/schema.prisma, con el mismo modelo y datasource.
//
// Antes había un segundo generador aquí mismo (`output` apuntando a
// dashboard/node_modules/.prisma/client) para evitar duplicar el modelo.
// Se descartó: Prisma resuelve `@prisma/client`/`prisma` recorriendo los
// directorios ANCESTROS del propio schema.prisma, nunca directorios
// hermanos — así que ese generador necesitaba encontrar `node_modules` en
// la raíz del repo. En Vercel, con Root Directory=dashboard, el
// `npm install` de la raíz nunca se ejecuta (no existe ese node_modules),
// así que Prisma intentaba auto-instalarse (`npm i prisma@... -D --silent`)
// en mitad del build — y esa instalación anidada fallaba de forma opaca.
//
// Si cambias el modelo `Message` o el datasource, replica el cambio en
// dashboard/prisma/schema.prisma.

datasource db {
  provider = "postgresql"
  // Runtime del bot: pooler de Supavisor en modo transacción (puerto 6543).
  // Conexiones puntuales por mensaje, ideal para PgBouncer.
  url       = env("DATABASE_URL")
  // Migraciones: conexión directa/sesión (puerto 5432). Prisma no puede migrar
  // a través del pooler en modo transacción (necesita sesión completa).
  directUrl  = env("DIRECT_URL")
  // pgvector ya viene disponible en Supabase; solo hace falta activarla
  // (CREATE EXTENSION, ver la migración) y declararla aquí para que Prisma
  // no la trate como drift del esquema en `migrate dev`.
  extensions = [vector]
}

/// Cuenta del dashboard. Multiusuario (Fase 2): cada usuario ve solo sus
/// propias notas — el bot de Telegram averigua a qué usuario pertenece un
/// mensaje entrante por `telegramChatId` (vinculado desde el dashboard con
/// un código corto, ver `linkCode`).
model User {
  id    String @id @default(cuid())
  email String @unique
  /// Opcional desde el login con Google: una cuenta creada solo por OAuth no
  /// tiene contraseña propia (ver dashboard/src/app/login/actions.ts, caso
  /// passwordHash null).
  passwordHash String?
  createdAt    DateTime @default(now())

  /// Si el registro fue por email/contraseña, empieza en false hasta que
  /// confirme el enlace del correo de verificación. Las cuentas por Google
  /// nacen ya verificadas (el id_token de Google ya certifica el email).
  emailVerified Boolean @default(false)

  /// Chat de Telegram vinculado a esta cuenta (null hasta que se vincula
  /// con /vincular). Único: un chat solo puede pertenecer a una cuenta.
  telegramChatId    BigInt?   @unique
  /// Código corto de un solo uso para vincular el chat de Telegram desde
  /// el dashboard (ver sección "Cuenta"). Expira a los ~10 minutos.
  linkCode          String?   @unique
  linkCodeExpiresAt DateTime?

  /// Workspace personal, autocreado al registrarse (Fase Equipo): el
  /// espacio privado 1-a-1 que ya existía implícitamente (userId como
  /// dueño único) ahora es un Workspace real con `personal = true`.
  /// Invariante estructural, no solo convención — @unique impide por
  /// diseño que una cuenta acabe con dos, y es una lectura O(1) en vez de
  /// un join+filtro contra Membership+Workspace.personal cada vez que
  /// hace falta saber "cuál es mi espacio personal".
  personalWorkspaceId String?    @unique
  personalWorkspace   Workspace? @relation("PersonalWorkspace", fields: [personalWorkspaceId], references: [id])

  messages         Message[]           @relation("MessageAuthor")
  assignedMessages Message[]           @relation("MessageAssignee")
  exchanges        AssistantExchange[]
  conversations    Conversation[]
  eventos          Evento[]            @relation("EventoAuthor")
  assignedEventos  Evento[]            @relation("EventoAssignee")
  cuentasAhorro    CuentaAhorro[]
  verificationTokens VerificationToken[]
  memberships      Membership[]

  @@map("users")
}

/// Ver dashboard/prisma/schema.prisma para la explicación completa del
/// modelo de equipo (Fase Equipo). Espacio de trabajo: personal (1 solo
/// miembro, autocreado al registrarse) o de equipo (varios miembros,
/// creado explícitamente). Message/Evento cuelgan de un Workspace, no
/// directamente de un User — para un workspace personal esto equivale
/// exactamente al comportamiento de antes (userId como único dueño), así
/// que no es un caso especial, es una generalización estricta.
model Workspace {
  id        String   @id @default(cuid())
  nombre    String
  /// true solo en el workspace personal autocreado de cada usuario — nunca
  /// se crea uno con personal=true desde la UI, solo desde el flujo de
  /// alta de cuenta (registro/actions.ts, googleOAuth.ts).
  personal  Boolean  @default(false)
  createdAt DateTime @default(now())

  memberships Membership[]
  messages    Message[]
  eventos     Evento[]
  /// Reverso de User.personalWorkspaceId — como máximo un usuario por
  /// workspace personal (impuesto por el @unique del otro lado).
  personalOf  User?    @relation("PersonalWorkspace")

  @@map("workspaces")
}

/// Rol dentro de un workspace de equipo. En esta fase SOLO gobierna la
/// administración del propio workspace (añadir/quitar miembros) — no
/// permisos por tarea: cualquier miembro ACTIVE puede crear/editar/
/// asignar/borrar cualquier tarea del workspace. Ampliar esto a permisos
/// más finos es una mejora futura, no de esta fase.
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

/// PENDING = se ha añadido a alguien por email pero aún no lo ha aceptado
/// (aparece como aviso pendiente hasta que entra y confirma); ACTIVE = ya
/// forma parte de verdad. Un Membership PENDING NO da acceso a los datos
/// del workspace todavía — el check de acceso exige status=ACTIVE.
enum MembershipStatus {
  PENDING
  ACTIVE
}

model Membership {
  userId      String
  workspaceId String
  role        WorkspaceRole    @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

/// Token de un solo uso para confirmar el email al registrarse (registro/
/// login profesional del dashboard). El bot no lo usa para nada.
model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

/// Estado de una tarea/recordatorio en el tablero kanban (Fase 3). Solo
/// relevante para categorías accionables (tarea/recordatorio) — el resto
/// de categorías no aparecen en el tablero y se quedan en POR_HACER sin
/// que nadie lo vea ni lo use.
enum EstadoTarea {
  POR_HACER
  EN_PROGRESO
  HECHO
}

/// Prioridad de una tarea/recordatorio (Fase 3).
enum Prioridad {
  BAJA
  MEDIA
  ALTA
}

/// Un mensaje entrante ya categorizado y resumido.
model Message {
  id        String   @id @default(cuid())
  /// Tipo de mensaje (p.ej. "text").
  tipo      String
  /// Contenido original del mensaje.
  contenido String
  /// Categoría asignada por la IA (tarea, idea, pregunta, ...).
  categoria String
  /// Resumen conciso generado por la IA.
  resumen   String
  /// ¿Está marcado como hecho? Solo relevante para categorías accionables
  /// (tarea/recordatorio). Al crearse siempre nace pendiente (false).
  /// Se mantiene sincronizado con `estado` (hecho = estado == HECHO): el
  /// bot y el resumen diario lo siguen usando tal cual, sin saber nada del
  /// tablero kanban del dashboard.
  hecho     Boolean  @default(false)
  /// Estado en el tablero kanban (Fase 3). Nace en POR_HACER.
  estado    EstadoTarea @default(POR_HACER)
  /// Prioridad en el tablero kanban (Fase 3). Nace en MEDIA.
  prioridad Prioridad   @default(MEDIA)
  /// Fecha de recepción/procesamiento.
  fecha     DateTime @default(now())

  /// Etiquetas libres (Fase F/J): a mayores de la categoría fija, texto
  /// suelto que el usuario añade desde el modal de detalle para filtrar
  /// más fino en el buscador. Sin tabla de definición aparte — un array
  /// nativo de Postgres es proporcional a la necesidad real (uso
  /// personal, no un editor de esquema de etiquetas por proyecto).
  etiquetas String[] @default([])

  /// Campos extra personalizados (Fase E): mapa libre `{nombre: {tipo,
  /// valor}}` (tipo: texto/numero/fecha, valor siempre como string — las
  /// fechas en ISO). Sin tabla de definición de campos aparte: para uso
  /// personal, un campo dinámico tipo JSON es proporcional a la necesidad
  /// real y evita construir un editor de "esquema de esquema" por tarjeta.
  camposExtra Json @default("{}")

  /// Imágenes adjuntas (Fase D del dashboard), URLs de Vercel Blob. Array
  /// simple en vez de una tabla Attachment aparte: proporcional al uso real
  /// (una nota, unas pocas capturas, no un gestor de ficheros). El bot no
  /// las usa (no hay forma de adjuntar una imagen por Telegram hoy).
  imagenes String[] @default([])

  /// Posición dentro de su columna del tablero kanban del dashboard: al
  /// crearse, la hora actual en milisegundos (siempre creciente, sin
  /// consultar el máximo actual). Indexado fraccionario (punto medio entre
  /// vecinas al arrastrar) — evita renumerar el resto de la columna en
  /// cada movimiento. El bot no lo usa (no tiene tablero).
  orden Float @default(0)

  /// Dueño de la nota (Fase 2, multiusuario). Obligatorio: el backfill de
  /// las notas previas a esta fase ya se completó (ver migración
  /// 20260804190000_require_user_owner). Quien la creó — nunca cambia,
  /// aunque se asigne a otra persona (ver `assigneeId`).
  userId String
  user   User   @relation("MessageAuthor", fields: [userId], references: [id])

  /// Workspace en el que vive (Fase Equipo): el personal del autor por
  /// defecto, o un workspace de equipo si se ha creado/movido ahí. Es el
  /// límite real de visibilidad — quien no sea miembro ACTIVE de este
  /// workspace no puede ver ni tocar esta fila. NOT NULL desde
  /// 20260810130000_require_message_workspace (backfill verificado en 0
  /// huérfanos) — mismo patrón que `userId` en su día.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  /// A quién se ha asignado esta tarea (Fase Equipo) — solo tiene sentido
  /// en un workspace de equipo; en el personal siempre queda null. Debe
  /// ser siempre un miembro ACTIVE del mismo `workspaceId` (comprobado a
  /// nivel de Server Action, Postgres no puede expresar esa referencia
  /// cruzada como constraint).
  assigneeId String?
  assignee   User?   @relation("MessageAssignee", fields: [assigneeId], references: [id])

  /// Vector de embedding para búsqueda semántica (Fase 2), generado con
  /// gemini-embedding-001 truncado a 768 dimensiones (Matryoshka Representation
  /// Learning: 768 conserva calidad de recuperación suficiente para este caso
  /// de uso y mantiene el índice HNSW barato). Nullable: null hasta que se
  /// genera (mensajes guardados sin GEMINI_API_KEY, o pendientes de backfill).
  /// Prisma no puede leer/escribir tipos `Unsupported` con el cliente
  /// tipado — todo acceso a esta columna es vía $queryRaw/$executeRaw.
  embedding Unsupported("vector(768)")?

  /// Eventos del calendario (Fase I) que el Asistente creó a partir de
  /// esta nota (p. ej. un recordatorio con fecha clara). Casi siempre
  /// vacío: la mayoría de notas no generan un evento.
  eventos Evento[]

  @@index([categoria])
  @@index([fecha])
  @@index([hecho])
  @@index([userId])
  @@index([estado])
  @@index([orden])
  @@index([workspaceId])
  @@index([assigneeId])
  @@map("messages")
}

/// Evento del calendario (Fase I): cita/recordatorio con fecha y hora,
/// creado a mano desde /calendario o por el Asistente cuando el usuario
/// describe algo con fecha clara ("quedar el jueves a las 5"). Distinto
/// de un `Message` con categoría "recordatorio": ese vive en el tablero
/// (estado/prioridad, sin hora concreta), esto vive en el calendario
/// (fecha y hora concretas, sin estado de kanban).
model Evento {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String?
  fechaInicio DateTime
  fechaFin    DateTime?
  ubicacion   String?
  /// Lista libre de nombres/emails sueltos — no un sistema de contactos,
  /// proporcional al uso de una app de notas personal.
  participantes String[] @default([])
  createdAt   DateTime @default(now())

  /// Quien lo creó — nunca cambia, aunque se asigne a otra persona (ver
  /// `assigneeId`). Ver comentario equivalente en Message.userId.
  userId String
  user   User   @relation("EventoAuthor", fields: [userId], references: [id])

  /// Ver comentario equivalente en Message.workspaceId.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  /// Ver comentario equivalente en Message.assigneeId.
  assigneeId String?
  assignee   User?   @relation("EventoAssignee", fields: [assigneeId], references: [id])

  /// Nota que originó este evento (si lo creó el Asistente a partir de
  /// una de tus notas). Null si se creó directamente desde /calendario.
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id])

  @@index([userId])
  @@index([fechaInicio])
  @@index([workspaceId])
  @@index([assigneeId])
  @@map("eventos")
}

/// Cuenta/bucket de ahorro (Fase K): "diversificar cuentas" — varios sitios
/// con nombre propio (fondo de emergencia, vacaciones, una cuenta real...)
/// en vez de un único número. El saldo NUNCA se guarda como campo propio:
/// se calcula sumando `MovimientoAhorro.centimos` al leer — así nunca puede
/// desincronizarse del historial que lo explica.
model CuentaAhorro {
  id        String   @id @default(cuid())
  nombre    String
  /// Objetivo de ahorro, en céntimos — opcional, solo para la barra de progreso.
  objetivoCentimos Int?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  movimientos MovimientoAhorro[]

  @@index([userId])
  @@map("cuentas_ahorro")
}

/// Un ingreso o retirada de una `CuentaAhorro`. Dinero siempre en céntimos
/// (entero): Float/Decimal para dinero es la fuente número uno de errores
/// de redondeo tontos — un entero no tiene ese problema.
model MovimientoAhorro {
  id       String   @id @default(cuid())
  /// Céntimos: positivo = ingreso, negativo = retirada.
  centimos Int
  concepto String?
  fecha    DateTime @default(now())

  cuentaId String
  cuenta   CuentaAhorro @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@index([cuentaId])
  @@map("movimientos_ahorro")
}

/// Fusible de coste propio del Asistente conversacional del dashboard
/// (independiente de MAX_MESSAGES_PER_DAY, que es solo del bot). Un
/// contador por día; el dashboard corre en Vercel (serverless, sin disco
/// persistente entre invocaciones), así que el contador vive en Postgres
/// en vez de en un fichero como el fusible del bot (ver src/cost/budget.ts).
model AssistantBudget {
  /// Día en curso, formato YYYY-MM-DD (UTC).
  day   String @id
  /// Preguntas consumidas ese día.
  count Int    @default(0)

  @@map("assistant_budget")
}

/// Rate limiting distribuido (login/registro): mismo patrón que
/// AssistantBudget (contador con upsert atómico), pero con ventana fija en
/// vez de por día — cada fila es una combinación (acción+IP, ventana de
/// tiempo). Necesario porque el limitador en memoria no se comparte entre
/// instancias serverless de Vercel ni sobrevive a un cold start; esta tabla
/// sí es la misma para todas. Se purga sola (ver purgeOldRateLimitBuckets,
/// llamada desde el mismo Cron Job semanal que purga el historial).
model RateLimitBucket {
  /// P.ej. "login:203.0.113.5" — acción + IP.
  bucketKey   String
  /// Inicio de la ventana de tiempo (alineada a windowMs desde epoch).
  windowStart DateTime
  /// Intentos en esta ventana.
  count       Int      @default(0)

  @@id([bucketKey, windowStart])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}

/// Conversación del Asistente (Fase 5): agrupa varios intercambios en un
/// mismo hilo navegable, como el historial de Claude — no pregunta-
/// respuesta suelta. `titulo` se autogenera a partir de la primera
/// pregunta. Se purga junto con sus intercambios (ver AssistantExchange):
/// una conversación sin intercambios (todos purgados por antigüedad) se
/// borra en el mismo Cron Job, para no dejar hilos vacíos en la lista.
model Conversation {
  id        String   @id @default(cuid())
  titulo    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  exchanges AssistantExchange[]

  @@index([userId])
  @@map("conversations")
}

/// Historial de intercambios con el Asistente (pregunta + respuesta ya
/// generada, texto plano). Se purga solo: un Cron Job semanal de Vercel
/// (ver dashboard/vercel.json) borra lo de más de 7 días, así que esta
/// tabla nunca crece sin límite ni hace falta gestionarla a mano.
model AssistantExchange {
  id        String   @id @default(cuid())
  pregunta  String
  respuesta String
  fecha     DateTime @default(now())

  /// Ver comentario de `Message.userId`.
  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// Hilo al que pertenece (Fase 5). Nullable: los intercambios de antes de
  /// la Fase 5 no pertenecen a ninguna conversación agrupada — se quedan
  /// fuera de la lista de conversaciones, no se les inventa un hilo.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  @@index([fecha])
  @@index([userId])
  @@index([conversationId])
  @@map("assistant_exchanges")
}
