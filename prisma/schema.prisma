// Esquema de Prisma para el clasificador de mensajes.
//
// La cadena de conexión llega por DATABASE_URL (en .env), NUNCA hardcodeada.
// Genera el cliente con `npm run prisma:generate` y crea la tabla con
// `npm run prisma:migrate` una vez tengas una base de datos PostgreSQL.

generator client {
  provider        = "prisma-client-js"
  // Necesario para declarar `extensions = [vector]` abajo. No cambia cómo se
  // generan los modelos normales.
  previewFeatures = ["postgresqlExtensions"]
}

// El dashboard (Next.js, app aparte en dashboard/, con su propio
// node_modules) mantiene su PROPIA copia de este schema en
// dashboard/prisma/schema.prisma, con el mismo modelo y datasource.
//
// Antes había un segundo generador aquí mismo (`output` apuntando a
// dashboard/node_modules/.prisma/client) para evitar duplicar el modelo.
// Se descartó: Prisma resuelve `@prisma/client`/`prisma` recorriendo los
// directorios ANCESTROS del propio schema.prisma, nunca directorios
// hermanos — así que ese generador necesitaba encontrar `node_modules` en
// la raíz del repo. En Vercel, con Root Directory=dashboard, el
// `npm install` de la raíz nunca se ejecuta (no existe ese node_modules),
// así que Prisma intentaba auto-instalarse (`npm i prisma@... -D --silent`)
// en mitad del build — y esa instalación anidada fallaba de forma opaca.
//
// Si cambias el modelo `Message` o el datasource, replica el cambio en
// dashboard/prisma/schema.prisma.

datasource db {
  provider = "postgresql"
  // Runtime del bot: pooler de Supavisor en modo transacción (puerto 6543).
  // Conexiones puntuales por mensaje, ideal para PgBouncer.
  url       = env("DATABASE_URL")
  // Migraciones: conexión directa/sesión (puerto 5432). Prisma no puede migrar
  // a través del pooler en modo transacción (necesita sesión completa).
  directUrl  = env("DIRECT_URL")
  // pgvector ya viene disponible en Supabase; solo hace falta activarla
  // (CREATE EXTENSION, ver la migración) y declararla aquí para que Prisma
  // no la trate como drift del esquema en `migrate dev`.
  extensions = [vector]
}

/// Cuenta del dashboard. Multiusuario (Fase 2): cada usuario ve solo sus
/// propias notas — el bot de Telegram averigua a qué usuario pertenece un
/// mensaje entrante por `telegramChatId` (vinculado desde el dashboard con
/// un código corto, ver `linkCode`).
model User {
  id    String @id @default(cuid())
  email String @unique
  /// Opcional desde el login con Google: una cuenta creada solo por OAuth no
  /// tiene contraseña propia (ver dashboard/src/app/login/actions.ts, caso
  /// passwordHash null).
  passwordHash String?
  createdAt    DateTime @default(now())

  /// Si el registro fue por email/contraseña, empieza en false hasta que
  /// confirme el enlace del correo de verificación. Las cuentas por Google
  /// nacen ya verificadas (el id_token de Google ya certifica el email).
  emailVerified Boolean @default(false)

  /// Cuenta corporativa creada por un owner/admin al añadir a alguien a un
  /// equipo por email sin que esa persona tuviera cuenta todavía (ver
  /// equipo/actions.ts) — true hasta que activa la cuenta eligiendo
  /// contraseña vía /restablecer-password. Necesario aparte de
  /// `passwordHash: null`: ese mismo valor también lo tiene una cuenta de
  /// Google normal (nunca necesita contraseña), así que por sí solo no
  /// basta para distinguir "pendiente de activar" de "no le hace falta".
  accountPending Boolean @default(false)

  /// Acceso al panel de administración global (/admin): ver todos los
  /// usuarios/equipos de la aplicación, restablecer contraseñas, verificar
  /// email a mano y eliminar cuentas — fuera del alcance de un
  /// OWNER/ADMIN normal (que solo administra SUS equipos). No hay UI para
  /// auto-concederse esto la primera vez a propósito: el primer superadmin
  /// se designa a mano contra la base de datos (ver SETUP.md), igual que
  /// cualquier operación de bootstrap sensible.
  isSuperAdmin Boolean @default(false)

  /// Preferencias de notificación por tipo — mapa `Record<NotificationType,
  /// boolean>` (Fase Equipo). Ausente = todo activado (comportamiento de
  /// siempre): solo se guarda lo que el usuario ha desactivado
  /// explícitamente, mismo criterio "proporcional al uso real" que
  /// Message.camposExtra — no una fila completa por cada tipo posible.
  notificationPrefs Json @default("{}")

  /// Chat de Telegram vinculado a esta cuenta (null hasta que se vincula
  /// con /vincular). Único: un chat solo puede pertenecer a una cuenta.
  telegramChatId    BigInt?   @unique
  /// Código corto de un solo uso para vincular el chat de Telegram desde
  /// el dashboard (ver sección "Cuenta"). Expira a los ~10 minutos.
  linkCode          String?   @unique
  linkCodeExpiresAt DateTime?

  /// Revocación de sesiones sin tabla de sesiones: todo JWT de sesión
  /// emitido ANTES de esta marca deja de valer (ver
  /// dashboard/src/lib/sessionRevocation.ts). Null = nunca se ha revocado
  /// nada, todas las sesiones valen. La mueve a "ahora" el cambio de
  /// contraseña (incluido el de "olvidé mi contraseña") y el botón de
  /// "cerrar sesión en el resto de dispositivos" de /cuenta.
  sessionsValidFrom DateTime?

  /// Cierra manualmente la tarjeta de "primeros pasos" en /asistente (ver
  /// dashboard/src/components/OnboardingChecklist.tsx) — aparte de
  /// ocultarse sola al completar lo esencial (Telegram vinculado + primera
  /// nota guardada), el usuario puede cerrarla en cualquier momento sin
  /// esperar a terminar los pasos.
  onboardingDismissed Boolean @default(false)

  /// Workspace personal, autocreado al registrarse (Fase Equipo): el
  /// espacio privado 1-a-1 que ya existía implícitamente (userId como
  /// dueño único) ahora es un Workspace real con `personal = true`.
  /// Invariante estructural, no solo convención — @unique impide por
  /// diseño que una cuenta acabe con dos, y es una lectura O(1) en vez de
  /// un join+filtro contra Membership+Workspace.personal cada vez que
  /// hace falta saber "cuál es mi espacio personal".
  personalWorkspaceId String?    @unique
  personalWorkspace   Workspace? @relation("PersonalWorkspace", fields: [personalWorkspaceId], references: [id])

  messages         Message[]           @relation("MessageAuthor")
  assignedMessages Message[]           @relation("MessageAssignee")
  enProgresoMessages Message[]         @relation("MessageEnProgreso")
  exchanges        AssistantExchange[]
  conversations    Conversation[]
  eventos          Evento[]            @relation("EventoAuthor")
  assignedEventos  Evento[]            @relation("EventoAssignee")
  cuentasAhorro    CuentaAhorro[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  memberships      Membership[]
  notifications    Notification[]
  chatMessages     ChatMessage[]
  assistantMemories AssistantMemory[]
  activityLogs     ActivityLog[]
  pushSubscriptions PushSubscription[]
  chatConversationsCreated ChatConversation[]            @relation("ChatConversationCreator")
  chatParticipations       ChatConversationParticipant[]

  @@map("users")
}

/// Ver dashboard/prisma/schema.prisma para la explicación completa del
/// modelo de equipo (Fase Equipo). Espacio de trabajo: personal (1 solo
/// miembro, autocreado al registrarse) o de equipo (varios miembros,
/// creado explícitamente). Message/Evento cuelgan de un Workspace, no
/// directamente de un User — para un workspace personal esto equivale
/// exactamente al comportamiento de antes (userId como único dueño), así
/// que no es un caso especial, es una generalización estricta.
model Workspace {
  id        String   @id @default(cuid())
  nombre    String
  /// true solo en el workspace personal autocreado de cada usuario — nunca
  /// se crea uno con personal=true desde la UI, solo desde el flujo de
  /// alta de cuenta (registro/actions.ts, googleOAuth.ts).
  personal  Boolean  @default(false)
  createdAt DateTime @default(now())

  /// Nombres personalizados de las 3 columnas del tablero (Fase Equipo) —
  /// mapa `Record<EstadoTarea, string>`, solo las que se han renombrado
  /// (ausente = usa la etiqueta por defecto, "Por hacer"/"En progreso"/
  /// "Hecho", ver ESTADO_PRESENTATION en lib/kanban.ts). El color y el
  /// propio flujo de trabajo (3 estados fijos, con qué se considera "en
  /// curso"/"hecho") no cambian — un obrador puede llamar "Pedidos" a
  /// "Por hacer" sin que el resto de la lógica del tablero necesite saber
  /// nada de eso.
  boardLabels Json @default("{}")

  memberships     Membership[]
  messages        Message[]
  eventos         Evento[]
  campoTemplates  CampoTemplate[]
  chatMessages    ChatMessage[]
  chatConversations ChatConversation[]
  assistantMemories AssistantMemory[]
  activityLogs    ActivityLog[]
  boardStatuses   BoardStatus[]
  /// Reverso de User.personalWorkspaceId — como máximo un usuario por
  /// workspace personal (impuesto por el @unique del otro lado).
  personalOf  User?    @relation("PersonalWorkspace")

  @@map("workspaces")
}

/// Plantilla reutilizable de campos personalizados por categoría dentro de
/// un workspace (uso empresarial: toda nota "Cliente" nace ya con
/// Empresa/Presupuesto/Contacto en vez de tener que añadirlos a mano cada
/// vez) — ver dashboard/src/lib/campoTemplates.ts para el shape de
/// `campos` y MessageDetailDialog.tsx para los botones "Aplicar
/// plantilla"/"Guardar como plantilla". Como mucho una plantilla por
/// categoría y workspace (@@unique) — guardar de nuevo sobre la misma
/// categoría la reemplaza entera, no la mezcla.
model CampoTemplate {
  id        String   @id @default(cuid())
  categoria String
  /// `Record<nombre, { tipo }>` — mismos tipos que `CampoExtraTipo`
  /// (texto/numero/fecha), pero SIN `valor`: esto es la definición
  /// reutilizable, no un dato concreto de una nota.
  campos    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, categoria])
  @@index([workspaceId])
  @@map("campo_templates")
}

/// Rol dentro de un workspace de equipo. OWNER/ADMIN administran el propio
/// workspace (añadir/quitar miembros, renombrar); MEMBER puede crear/
/// editar/asignar/borrar cualquier nota o evento del workspace. VIEWER es
/// la única excepción a "mismos permisos sobre el contenido": solo lectura
/// — pensado para un cliente o stakeholder externo que necesita ver el
/// tablero/calendario compartido sin poder tocar nada. La comprobación
/// vive en cada Server Action de escritura (`canWrite()` en
/// dashboard/src/lib/workspace.ts), no aquí: Postgres no puede expresar
/// "todos los roles menos uno" como constraint.
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// PENDING = se ha añadido a alguien por email pero aún no lo ha aceptado
/// (aparece como aviso pendiente hasta que entra y confirma); ACTIVE = ya
/// forma parte de verdad. Un Membership PENDING NO da acceso a los datos
/// del workspace todavía — el check de acceso exige status=ACTIVE.
enum MembershipStatus {
  PENDING
  ACTIVE
}

/// Estado manual que cada miembro elige para sí mismo (Fase Equipo: chat de
/// equipo) — visible para el resto y consultable por el Asistente. Distinto
/// de "en línea" (derivado de `lastSeenAt`, automático) y de "en curso ahora"
/// (qué tarea concreta lleva, ver Message.enProgresoPorId): esto es solo la
/// disponibilidad que la propia persona comunica ("estoy ocupado, no me
/// interrumpáis").
enum MemberPresence {
  DISPONIBLE
  OCUPADO
  FUERA
}

model Membership {
  userId      String
  workspaceId String
  role        WorkspaceRole    @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())

  /// Estado manual (ver MemberPresence) — null = disponible por defecto,
  /// sin obligar a elegir nada la primera vez.
  presenceStatus MemberPresence?

  /// Último "latido" de actividad en un workspace de equipo (ver
  /// CurrentTaskBar.tsx, que ya sondea cada 20s en modo equipo) — de ahí se
  /// deriva "en línea" (reciente) sin tabla de sesiones aparte. No es
  /// exacto al segundo, es una señal de presencia aproximada, suficiente
  /// para un equipo pequeño.
  lastSeenAt DateTime?

  /// Categorías que este miembro ha ocultado en Notas/Tablero — preferencia
  /// PERSONAL, no del workspace: cada uno oculta lo que no usa sin afectar
  /// a los demás miembros del mismo equipo.
  hiddenCategories String[] @default([])

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

/// Token de un solo uso para confirmar el email al registrarse (registro/
/// login profesional del dashboard). El bot no lo usa para nada.
model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

/// Token de un solo uso para restablecer la contraseña ("olvidé mi
/// contraseña" desde /login). Modelo aparte de VerificationToken a
/// propósito: son dos acciones con impacto muy distinto (confirmar un
/// email vs. tomar el control total de la cuenta), y una cuenta puede
/// tener un token de cada tipo vivo a la vez sin que se pisen.
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Tipo de notificación (Fase Equipo): de momento solo asignación — se
/// asigna una tarea/evento a alguien y esa persona se entera sin tener
/// que ir mirando el tablero/calendario por si acaso. Enum en vez de un
/// string libre para que la UI sepa qué icono/verbo usar por tipo.
enum NotificationType {
  ASSIGNED_MESSAGE
  ASSIGNED_EVENTO
  /// Te han añadido a un equipo (cuenta nueva creada para ti, o invitación
  /// pendiente sobre una cuenta ya existente).
  ADDED_TO_TEAM
  /// Un owner/admin te ha cambiado el rol dentro de un equipo.
  ROLE_CHANGED
  /// Te han invitado a un GRUPO de chat que no es el "Equipo" automático de
  /// ningún workspace tuyo — ver ChatParticipantStatus. Accionable desde la
  /// propia notificación (aceptar/rechazar), no solo un enlace.
  CHAT_INVITE
}

/// Notificación en la app (Fase Equipo). Sin canal externo (email/push)
/// todavía a propósito — empieza como bandeja dentro de la propia app
/// (campana en el Sidebar), lo mínimo que hace que "asignar" deje de ser
/// mudo. `link` apunta directamente a la tarjeta/evento asignado.
model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

/// Suscripción push del navegador (Web Push estándar, VAPID) — un usuario
/// puede tener varias (un móvil, un portátil...). Se crea al aceptar el
/// permiso de notificaciones desde /cuenta; se borra sola si el navegador
/// la invalida (endpoint caducado, ver lib/webPush.ts).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Registro de actividad del workspace (Fase Equipo) — "qué ha pasado en
/// el equipo", sin destinatario (a diferencia de Notification, que es
/// personal para quien recibe el aviso). `tipo` es texto libre (mismo
/// criterio que Message.categoria), no un enum — nuevos tipos de
/// actividad no deben exigir una migración de esquema.
model ActivityLog {
  id        String   @id @default(cuid())
  /// P.ej. "nota_creada", "tarea_asignada", "tarea_completada".
  tipo      String
  /// Qué tipo de cosa fue ("mensaje", "evento", "miembro") — para poder
  /// enlazar o filtrar sin tener que interpretar `tipo` a mano.
  entidad   String
  /// Id de la entidad afectada (mensaje/evento/usuario) — null si no aplica.
  entidadId String?
  /// Datos libres del evento (p. ej. el resumen del mensaje, el email
  /// asignado) — para que el feed pueda mostrar algo legible sin tener que
  /// volver a consultar la entidad, que puede haberse borrado ya.
  detalle   Json     @default("{}")
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("activity_log")
}

/// Tipo de conversación de chat (Fase Mensajería): individual (2
/// participantes, como un WhatsApp 1-a-1) o grupo (N participantes, con
/// nombre propio). Sustituye al antiguo "un único canal por workspace" —
/// ahora un workspace de equipo puede tener varias conversaciones a la vez.
enum ChatConversationType {
  DIRECT
  GROUP
}

/// Estado de UN participante dentro de una conversación (Fase Mensajería —
/// invitaciones). PENDING = le han invitado a un GRUPO y todavía no ha
/// decidido; ACTIVE = ya lee y escribe ahí. Las conversaciones DIRECT no
/// pasan por PENDING (ver createDirectConversation en chat/actions.ts): un
/// hilo 1-a-1 sin mensajes no molesta a nadie, así que pedir que se acepte
/// antes de que exista una sola palabra sería fricción sin beneficio — la
/// propuesta se justifica en grupos, donde te pueden meter en una
/// conversación de gente que no elegiste.
enum ChatParticipantStatus {
  PENDING
  ACTIVE
}

/// Conversación de chat: DIRECT y GROUP creados a mano SIEMPRE son
/// personales (`workspaceId` null) — pertenecen a las personas, no a un
/// equipo, así que se ven igual en espacio personal o en cualquier
/// workspace de equipo, y se puede invitar a cualquiera con cuenta en la
/// app, sea o no compañero de equipo. La única conversación con
/// `workspaceId` propio es el grupo "Equipo" autocreado por workspace (ver
/// ensureDefaultGroupConversation en chat/actions.ts): ese sí depende de la
/// pertenencia al equipo.
model ChatConversation {
  id        String               @id @default(cuid())
  type      ChatConversationType
  /// Nombre propio, solo en GROUP — en DIRECT se deriva del otro
  /// participante al mostrarla, no se guarda.
  nombre    String?
  /// Solo DIRECT: los dos ids de participante, orden alfabético, unidos por
  /// "_" — permite encontrar (o evitar duplicar) el hilo 1-a-1 entre dos
  /// personas concretas SIN pasar por ningún workspace (las DIRECT son
  /// siempre personales). Null en GROUP (sin este límite: puede haber
  /// varios grupos cualquiera).
  directKey String?
  createdAt DateTime             @default(now())

  /// Null = conversación personal (DIRECT, o GROUP creado a mano). Solo el
  /// grupo "Equipo" autocreado por workspace lleva un valor aquí.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ChatConversationCreator", fields: [createdById], references: [id])

  participants ChatConversationParticipant[]
  messages     ChatMessage[]

  @@unique([directKey])
  @@index([workspaceId])
  @@map("chat_conversations")
}

/// Quién participa en cada conversación (Fase Mensajería) — de aquí sale
/// tanto la lista de miembros de un grupo como el "no leído"/silencio, que
/// ahora es POR CONVERSACIÓN (antes era uno solo para todo el chat del
/// workspace, ver Membership — chatMuted/lastChatReadAt se retiraron de
/// ahí al pasar a varias conversaciones por workspace).
model ChatConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  /// Último momento en que este participante entró a leer esta
  /// conversación concreta — null hasta la primera visita.
  lastReadAt     DateTime?
  /// Silencia ESTA conversación para este participante — no enciende el
  /// punto de "no leído" del menú, aunque sí se sigue pudiendo leer/escribir.
  muted          Boolean   @default(false)
  /// PENDING mientras no ha aceptado la invitación a un grupo (ver el
  /// comentario de ChatParticipantStatus) — @default(ACTIVE) para que
  /// ninguna fila existente cambie de comportamiento con esta migración: el
  /// creador de una conversación, y todo lo que ya existía antes de esto,
  /// nace/sigue ACTIVE.
  status         ChatParticipantStatus @default(ACTIVE)

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("chat_conversation_participants")
}

/// Un mensaje dentro de una conversación (Fase Mensajería) — cualquier
/// participante ACTIVO del workspace puede escribir y leer en las
/// conversaciones de las que forma parte, INCLUIDO el rol VIEWER (el chat
/// es comunicación, no una mutación de contenido del workspace, así que no
/// lo alcanza `canWrite`). El aviso de mensajes nuevos llega por sondeo/
/// Realtime desde el cliente (ver dashboard/src/lib/chatRealtime.ts), no
/// por Notification (un aviso por mensaje sería ruido constante).
model ChatMessage {
  id        String   @id @default(cuid())
  /// Puede quedar vacío si el mensaje es solo una imagen (ver `imagenUrl`)
  /// — la Server Action exige al menos uno de los dos, no los dos a la vez.
  texto     String
  createdAt DateTime @default(now())

  /// Imagen adjunta (opcional), URL de Vercel Blob — mismo proveedor que
  /// las imágenes de notas (ver lib/blobUpload.ts). Un único campo, no un
  /// array como Message.imagenes: un mensaje de chat es una unidad corta,
  /// no una nota que acumula varias capturas.
  imagenUrl String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Workspace del que cuelga (denormalizado desde `conversation.workspaceId`)
  /// — se mantiene para no tener que pasar por la conversación en consultas
  /// que ya filtran por workspace. Null en conversaciones personales (ver
  /// ChatConversation.workspaceId).
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

/// Estado de una tarea/recordatorio en el tablero kanban (Fase 3). Solo
/// relevante para categorías accionables (tarea/recordatorio) — el resto
/// de categorías no aparecen en el tablero y se quedan en POR_HACER sin
/// que nadie lo vea ni lo use.
enum EstadoTarea {
  POR_HACER
  EN_PROGRESO
  HECHO
}

/// Prioridad de una tarea/recordatorio (Fase 3).
enum Prioridad {
  BAJA
  MEDIA
  ALTA
}

/// Columna propia del tablero de un workspace ("En diseño", "En revisión",
/// "Esperando al cliente"...). Un obrador, una asesoría y un estudio no
/// llevan las tareas igual, y tres columnas fijas no dan para todos.
///
/// DISEÑO IMPORTANTE — esto NO sustituye a `Message.estado`, lo acompaña.
/// Cada columna declara a qué `fase` del ciclo pertenece, y `Message.estado`
/// se sigue guardando siempre con esa fase. Así todo lo que pregunta "¿está
/// abierta?", "¿está hecha?", "¿está vencida?" (las cifras de Inicio, las
/// tools del Asistente, los avisos, el resumen diario) sigue funcionando sin
/// enterarse de que existen columnas propias: una tarea en "En revisión"
/// es, a todos los efectos, una tarea EN_PROGRESO.
///
/// Un workspace sin ninguna fila aquí usa las tres columnas de siempre
/// derivadas del enum — no hay que migrar nada ni "activar" la función.
model BoardStatus {
  id     String @id @default(cuid())
  nombre String
  /// Posición de izquierda a derecha en el tablero.
  orden  Int
  /// Fase del ciclo a la que equivale esta columna. Lo que mantiene
  /// coherente al resto de la aplicación (ver el comentario de arriba).
  fase   EstadoTarea

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  messages Message[]

  @@index([workspaceId, orden])
  @@map("board_statuses")
}

/// Un mensaje entrante ya categorizado y resumido.
model Message {
  id        String   @id @default(cuid())
  /// Tipo de mensaje (p.ej. "text").
  tipo      String
  /// Contenido original del mensaje.
  contenido String
  /// Categoría asignada por la IA (tarea, idea, pregunta, ...).
  categoria String
  /// Resumen conciso generado por la IA.
  resumen   String
  /// ¿Está marcado como hecho? Solo relevante para categorías accionables
  /// (tarea/recordatorio). Al crearse siempre nace pendiente (false).
  /// Se mantiene sincronizado con `estado` (hecho = estado == HECHO): el
  /// bot y el resumen diario lo siguen usando tal cual, sin saber nada del
  /// tablero kanban del dashboard.
  hecho     Boolean  @default(false)
  /// Estado en el tablero kanban (Fase 3). Nace en POR_HACER. Sigue siendo
  /// la verdad semántica (abierta/en curso/hecha) incluso con columnas
  /// propias — ver `boardStatusId` y el comentario de `BoardStatus`.
  estado    EstadoTarea @default(POR_HACER)
  /// En qué columna PROPIA del workspace está, si el workspace tiene las
  /// suyas. Null = está en la columna por defecto que corresponda a su
  /// `estado`. Al borrar una columna, sus tarjetas vuelven a null (no se
  /// pierde ninguna, caen en la columna por defecto de su fase).
  boardStatusId String?
  boardStatus   BoardStatus? @relation(fields: [boardStatusId], references: [id], onDelete: SetNull)
  /// Prioridad en el tablero kanban (Fase 3). Nace en MEDIA.
  prioridad Prioridad   @default(MEDIA)
  /// Fecha de recepción/procesamiento.
  fecha     DateTime @default(now())

  /// Fecha límite/recordatorio de una tarea o recordatorio ("aplazar
  /// tarea"), distinta de `fecha` (que es cuándo se creó, no cuándo
  /// vence). Nullable: la mayoría de notas no tienen fecha límite. Solo
  /// tiene sentido para categorías accionables, pero no se restringe a
  /// nivel de esquema — igual que `estado`/`prioridad`, que ya conviven
  /// sin usarse en categorías no accionables.
  fechaLimite DateTime?

  /// Etiquetas libres (Fase F/J): a mayores de la categoría fija, texto
  /// suelto que el usuario añade desde el modal de detalle para filtrar
  /// más fino en el buscador. Sin tabla de definición aparte — un array
  /// nativo de Postgres es proporcional a la necesidad real (uso
  /// personal, no un editor de esquema de etiquetas por proyecto).
  etiquetas String[] @default([])

  /// Campos extra personalizados (Fase E): mapa libre `{nombre: {tipo,
  /// valor}}` (tipo: texto/numero/fecha, valor siempre como string — las
  /// fechas en ISO). Sin tabla de definición de campos aparte: para uso
  /// personal, un campo dinámico tipo JSON es proporcional a la necesidad
  /// real y evita construir un editor de "esquema de esquema" por tarjeta.
  camposExtra Json @default("{}")

  /// Checklist / subtareas dentro de una tarea (organización): array de
  /// `{id, texto, hecho}`. Campo propio, deliberadamente NO reutiliza
  /// `camposExtra` — ese es un diccionario de campos personalizados con
  /// otra forma (nombre → {tipo, valor}); mezclar los dos haría que uno
  /// pisara al otro. Sin tabla `Subtarea` aparte, mismo criterio que
  /// `camposExtra`: proporcional al uso real, no un modelo relacional
  /// completo para una lista corta dentro de una tarjeta.
  checklist Json @default("[]")

  /// Imágenes adjuntas (Fase D del dashboard), URLs de Vercel Blob. Array
  /// simple en vez de una tabla Attachment aparte: proporcional al uso real
  /// (una nota, unas pocas capturas, no un gestor de ficheros). El bot no
  /// las usa (no hay forma de adjuntar una imagen por Telegram hoy).
  imagenes String[] @default([])

  /// Posición dentro de su columna del tablero kanban del dashboard: al
  /// crearse, la hora actual en milisegundos (siempre creciente, sin
  /// consultar el máximo actual). Indexado fraccionario (punto medio entre
  /// vecinas al arrastrar) — evita renumerar el resto de la columna en
  /// cada movimiento. El bot no lo usa (no tiene tablero).
  orden Float @default(0)

  /// Dueño de la nota (Fase 2, multiusuario). Obligatorio: el backfill de
  /// las notas previas a esta fase ya se completó (ver migración
  /// 20260804190000_require_user_owner). Quien la creó — nunca cambia,
  /// aunque se asigne a otra persona (ver `assigneeId`).
  userId String
  user   User   @relation("MessageAuthor", fields: [userId], references: [id])

  /// Workspace en el que vive (Fase Equipo): el personal del autor por
  /// defecto, o un workspace de equipo si se ha creado/movido ahí. Es el
  /// límite real de visibilidad — quien no sea miembro ACTIVE de este
  /// workspace no puede ver ni tocar esta fila. NOT NULL desde
  /// 20260810130000_require_message_workspace (backfill verificado en 0
  /// huérfanos) — mismo patrón que `userId` en su día.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  /// A quién se ha asignado esta tarea (Fase Equipo) — solo tiene sentido
  /// en un workspace de equipo; en el personal siempre queda null. Debe
  /// ser siempre un miembro ACTIVE del mismo `workspaceId` (comprobado a
  /// nivel de Server Action, Postgres no puede expresar esa referencia
  /// cruzada como constraint).
  assigneeId String?
  assignee   User?   @relation("MessageAssignee", fields: [assigneeId], references: [id])

  /// "En curso ahora" (Fase Equipo): quién está trabajando activamente en
  /// esta tarea/recordatorio EN ESTE MOMENTO, visible en vivo para el
  /// resto del equipo (sondeo corto desde el cliente, sin WebSocket/SSE).
  /// Distinto de `assigneeId` (quién la tiene asignada, permanente) —
  /// cualquiera puede "empezar" una tarea asignada a otro o sin asignar.
  /// Null = nadie está en ello ahora mismo. Se limpia sola al marcar la
  /// tarea como HECHA (ver updateTaskStatus/moveTask/updateMessage).
  enProgresoPorId String?
  enProgresoPor   User?     @relation("MessageEnProgreso", fields: [enProgresoPorId], references: [id])
  enProgresoDesde DateTime?

  /// Vector de embedding para búsqueda semántica (Fase 2), generado con
  /// gemini-embedding-001 truncado a 768 dimensiones (Matryoshka Representation
  /// Learning: 768 conserva calidad de recuperación suficiente para este caso
  /// de uso y mantiene el índice HNSW barato). Nullable: null hasta que se
  /// genera (mensajes guardados sin GEMINI_API_KEY, o pendientes de backfill).
  /// Prisma no puede leer/escribir tipos `Unsupported` con el cliente
  /// tipado — todo acceso a esta columna es vía $queryRaw/$executeRaw.
  embedding Unsupported("vector(768)")?

  /// Eventos del calendario (Fase I) que el Asistente creó a partir de
  /// esta nota (p. ej. un recordatorio con fecha clara). Casi siempre
  /// vacío: la mayoría de notas no generan un evento.
  eventos Evento[]

  @@index([categoria])
  @@index([fecha])
  @@index([fechaLimite])
  @@index([hecho])
  @@index([userId])
  @@index([estado])
  @@index([orden])
  @@index([workspaceId])
  @@index([assigneeId])
  @@index([enProgresoPorId])
  @@map("messages")
}

/// Evento del calendario (Fase I): cita/recordatorio con fecha y hora,
/// creado a mano desde /calendario o por el Asistente cuando el usuario
/// describe algo con fecha clara ("quedar el jueves a las 5"). Distinto
/// de un `Message` con categoría "recordatorio": ese vive en el tablero
/// (estado/prioridad, sin hora concreta), esto vive en el calendario
/// (fecha y hora concretas, sin estado de kanban).
model Evento {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String?
  fechaInicio DateTime
  fechaFin    DateTime?
  ubicacion   String?
  /// Lista libre de nombres/emails sueltos — no un sistema de contactos,
  /// proporcional al uso de una app de notas personal.
  participantes String[] @default([])
  createdAt   DateTime @default(now())

  /// Quien lo creó — nunca cambia, aunque se asigne a otra persona (ver
  /// `assigneeId`). Ver comentario equivalente en Message.userId.
  userId String
  user   User   @relation("EventoAuthor", fields: [userId], references: [id])

  /// Ver comentario equivalente en Message.workspaceId.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  /// Ver comentario equivalente en Message.assigneeId.
  assigneeId String?
  assignee   User?   @relation("EventoAssignee", fields: [assigneeId], references: [id])

  /// Nota que originó este evento (si lo creó el Asistente a partir de
  /// una de tus notas). Null si se creó directamente desde /calendario.
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id])

  @@index([userId])
  @@index([fechaInicio])
  @@index([workspaceId])
  @@index([assigneeId])
  @@map("eventos")
}

/// Cuenta/bucket de ahorro (Fase K): "diversificar cuentas" — varios sitios
/// con nombre propio (fondo de emergencia, vacaciones, una cuenta real...)
/// en vez de un único número. El saldo NUNCA se guarda como campo propio:
/// se calcula sumando `MovimientoAhorro.centimos` al leer — así nunca puede
/// desincronizarse del historial que lo explica.
model CuentaAhorro {
  id        String   @id @default(cuid())
  nombre    String
  /// Objetivo de ahorro, en céntimos — opcional, solo para la barra de progreso.
  objetivoCentimos Int?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  movimientos MovimientoAhorro[]

  @@index([userId])
  @@map("cuentas_ahorro")
}

/// Un ingreso o retirada de una `CuentaAhorro`. Dinero siempre en céntimos
/// (entero): Float/Decimal para dinero es la fuente número uno de errores
/// de redondeo tontos — un entero no tiene ese problema.
model MovimientoAhorro {
  id       String   @id @default(cuid())
  /// Céntimos: positivo = ingreso, negativo = retirada.
  centimos Int
  concepto String?
  fecha    DateTime @default(now())

  cuentaId String
  cuenta   CuentaAhorro @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@index([cuentaId])
  @@map("movimientos_ahorro")
}

/// Fusible de coste propio del Asistente conversacional del dashboard, POR
/// USUARIO (antes era un contador global: un solo usuario preguntando mucho
/// podía agotar el límite diario para TODOS los demás). Independiente de
/// MAX_MESSAGES_PER_DAY, que es solo del bot. El dashboard corre en Vercel
/// (serverless, sin disco persistente entre invocaciones), así que el
/// contador vive en Postgres en vez de en un fichero como el fusible del
/// bot (ver src/cost/budget.ts).
model AssistantBudget {
  /// Día en curso, formato YYYY-MM-DD (UTC).
  day    String
  userId String
  /// Preguntas consumidas ese día por este usuario.
  count  Int    @default(0)

  @@id([day, userId])
  @@map("assistant_budget")
}

/// Rate limiting distribuido (login/registro): mismo patrón que
/// AssistantBudget (contador con upsert atómico), pero con ventana fija en
/// vez de por día — cada fila es una combinación (acción+IP, ventana de
/// tiempo). Necesario porque el limitador en memoria no se comparte entre
/// instancias serverless de Vercel ni sobrevive a un cold start; esta tabla
/// sí es la misma para todas. Se purga sola (ver purgeOldRateLimitBuckets,
/// llamada desde el mismo Cron Job semanal que purga el historial).
model RateLimitBucket {
  /// P.ej. "login:203.0.113.5" — acción + IP.
  bucketKey   String
  /// Inicio de la ventana de tiempo (alineada a windowMs desde epoch).
  windowStart DateTime
  /// Intentos en esta ventana.
  count       Int      @default(0)

  @@id([bucketKey, windowStart])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}

/// Conversación del Asistente (Fase 5): agrupa varios intercambios en un
/// mismo hilo navegable, como el historial de Claude — no pregunta-
/// respuesta suelta. `titulo` se autogenera a partir de la primera
/// pregunta. Se purga junto con sus intercambios (ver AssistantExchange):
/// una conversación sin intercambios (todos purgados por antigüedad) se
/// borra en el mismo Cron Job, para no dejar hilos vacíos en la lista.
model Conversation {
  id        String   @id @default(cuid())
  titulo    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  exchanges AssistantExchange[]

  @@index([userId])
  @@map("conversations")
}

/// Historial de intercambios con el Asistente (pregunta + respuesta ya
/// generada, texto plano). Se purga solo: un Cron Job semanal de Vercel
/// (ver dashboard/vercel.json) borra lo de más de 7 días, así que esta
/// tabla nunca crece sin límite ni hace falta gestionarla a mano.
model AssistantExchange {
  id        String   @id @default(cuid())
  pregunta  String
  respuesta String
  fecha     DateTime @default(now())

  /// Ver comentario de `Message.userId`.
  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// Hilo al que pertenece (Fase 5). Nullable: los intercambios de antes de
  /// la Fase 5 no pertenecen a ninguna conversación agrupada — se quedan
  /// fuera de la lista de conversaciones, no se les inventa un hilo.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  @@index([fecha])
  @@index([userId])
  @@index([conversationId])
  @@map("assistant_exchanges")
}

/// Memoria persistente del Asistente (distinta de AssistantExchange, que es
/// solo un log de turnos purgado a los 7 días): hechos/preferencias cortos
/// en lenguaje natural que el Asistente debe recordar SIEMPRE, no solo
/// dentro de la conversación en curso ("los jueves cierro antes", "el
/// cliente López siempre es prioridad"). Escopado a un workspace concreto
/// (no global cruzando espacios) — mismo criterio que el resto del
/// esquema: todo cuelga de un Workspace, el personal incluido, así que un
/// hecho dicho en el equipo de un negocio no se filtra al espacio personal
/// ni a otro equipo distinto.
model AssistantMemory {
  id        String   @id @default(cuid())
  hecho     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId])
  @@map("assistant_memories")
}
